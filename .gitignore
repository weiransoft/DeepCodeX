# OS metadata
.DS_Store
Thumbs.db
# 已从 Git 历史移除的文档子目录，防止误重新提交
docs/dev/
docs/enterprise/
docs/fusion/
docs/reports/
docs/research/
docs/superpowers/
docs/visualizers/
# Dependency directory
node_modules/
# Ignore built ts files
dist/
out/


# Editors
.idea/
.vscode/
*.tgz
*.log
*.vsix
.deepcode/settings.json

# team 运行状态（L1-3 dispatch / L2 编排事件日志：<projectRoot>/.deepcode/team-runs/<runId>/）
# 属于运行时产物，每次 dispatch / 编排都会新增目录，不应入库。
# 必须带 `**/`：projectRoot 可能是仓库根，也可能是 packages/core 这类子包目录
# （测试的临时 projectRoot 一般落在 /tmp，但偶尔会落回包目录）。
**/.deepcode/team-runs/

# 司南的长期记忆（<homeRoot>/.deepcode/soul/memory.json 与 <projectRoot>/.deepcode/soul/memory.json）
# 里面可能有项目地址、部署位置、常用密码这类原文，0600/0700 只挡本机其它用户，
# 挡不住 `git add -A` 把凭证明文带进仓库，所以必须忽略。清空记忆走 `deepcodex super soul --forget`。
**/.deepcode/soul/

# TypeScript build info files
*.tsbuildinfo

# Python（scripts/voice 的 MLX sidecar）
# venv 里是几百 MB 的二进制轮子，模型权重另存 ~/.cache/huggingface，
# 两者都不该进仓库；__pycache__ 每次运行都会重新生成。
**/__pycache__/
*.pyc
scripts/voice/.venv/

# Environment variables
.env
.env.local

# Generated files
packages/cli/src/generated/
packages/core/src/generated/
packages/vscode-ide-companion/*.vsix
packages/vscode-ide-companion/templates/

# Runtime feedback data (agent 反馈数据，运行时生成不应入库)
packages/core/feedback_data/
feedback_data/

# Runtime state dir (.deepcodex 运行时状态，不应入库)
.deepcodex/

# E2E 测试运行产物 (运行时生成，不应入库)
tests/e2e-output/
tests/e2e-reports/

# 覆盖率运行产物 (本地 Coverage 步骤等价实测生成，CI 中经 artifact 归档，不应入库)
coverage/
coverage.lcov
coverage.deduped.lcov

# Backup files (开发过程备份文件，不应入库)
*.bak
*.bak2
*.bak3
*.bak4
*.bak5

# 发布产物（GitHub Release asset，不入库）
deploy/*.tgz

# WorkBuddy 工作区（本机记忆日志与会话数据，不入库；本地保留不删除）
.workbuddy/

# 临时图标素材（本机挑选用，不入库）
tmp-icon/

# 一次性诊断脚本（本机排查 LLM 配置用，不入库）
packages/web/.llm-probe.mts

# web 测试运行时 cwd 落在 tests/ 时生成的会话存储（16 位 hex 文件名，运行产物）
packages/web/tests/[0-9a-f][0-9a-f]*.json

# 本机生成的临时图片素材（图标挑选等，不入库）
generated-images/
