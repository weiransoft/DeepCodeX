{
  "name": "@vegamo/deepcode-monorepo",
  "version": "0.4.5",
  "private": true,
  "description": "Deep Code — CLI, core library, and VSCode companion",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lessweb/deepcode-cli.git"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate": "node scripts/generate-git-commit-info.js",
    "bundle": "npm run generate && node scripts/esbuild.config.js && node scripts/copy-bundle-assets.js",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\" --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\"",
    "check:ipc": "node scripts/check-desktop-ipc-contract.mjs",
    "test:e2e:super": "tsx tests/scripts/super-agent-e2e.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:ipc",
    "clean": "node scripts/clean.js",
    "build": "node scripts/build.js",
    "build:vscode": "node scripts/build-vscode-companion.js",
    "start": "node scripts/start.js",
    "build-and-start": "npm run build && npm run start",
    "test": "node tests/run-tests.mjs && npm run test --workspaces --if-present",
    "test:voice:unit": "python3 scripts/voice/test_continuity.py",
    "test:voice:continuity": "python3 scripts/voice/check_continuity.py",
    "test:voice:longtext": "python3 scripts/voice/longtext_probe.py --check",
    "test:voice:prod": "python3 scripts/voice/longtext_probe.py --from-config --cases pure_cn,mixed_tech",
    "test:voice:perception": "python3 scripts/voice/perception_probe.py --from-config --cases pure_cn,mixed_tech --check",
    "test:voice:loudness": "scripts/voice/.venv/bin/python scripts/voice/loudness_ab_probe.py --from-config --cases pure_cn,mixed_tech --check",
    "test:voice:consistency": "scripts/voice/.venv/bin/python scripts/voice/consistency_probe.py --from-config --cases pure_cn,mixed_tech --check",
    "test:voice:spectral": "scripts/voice/.venv/bin/python scripts/voice/spectral_ab_probe.py --from-config --cases pure_cn,mixed_tech --check",
    "test:voice:timbre": "scripts/voice/.venv/bin/python scripts/voice/timbre_probe.py --from-config --case pure_cn --comp on --compare-blocks --steady --skip-experiments",
    "test:voice:strength": "scripts/voice/.venv/bin/python scripts/voice/timbre_probe.py --from-config --case pure_cn --comp on --strengths 0,0.3,0.6,0.85,1.0 --skip-experiments --out /tmp/dcx-strength-scan && scripts/voice/.venv/bin/python scripts/voice/timbre_probe.py --from-config --case mixed_tech --comp on --strengths 0,0.3,0.6,0.85,1.0 --skip-experiments --out /tmp/dcx-strength-scan",
    "test:voice:longtext:steady": "scripts/voice/.venv/bin/python scripts/voice/longtext_probe.py --from-config --cases pure_cn,mixed_tech --steady --check",
    "test:voice:instruct": "scripts/voice/.venv/bin/python scripts/voice/timbre_probe.py --from-config --case pure_cn --comp on --instructs \"default|none|voice:serena\" --skip-experiments --out /tmp/dcx-instruct-v15 && scripts/voice/.venv/bin/python scripts/voice/timbre_probe.py --from-config --case mixed_tech --comp on --instructs \"default|none|voice:serena\" --skip-experiments --out /tmp/dcx-instruct-v15",
    "test:voice:loudness:unit": "scripts/voice/.venv/bin/python scripts/voice/test_loudness_lufs.py",
    "test:voice:loudness:live": "scripts/voice/.venv/bin/python scripts/voice/loudness_drift_probe.py --live --from-config --case mixed_tech --voice serena --with-v12 --with-v14 --out /tmp/dcx-loudness-r16/mixed_tech && scripts/voice/.venv/bin/python scripts/voice/loudness_drift_probe.py --compare /tmp/dcx-loudness-r16/mixed_tech/raw /tmp/dcx-loudness-r16/mixed_tech/v12 /tmp/dcx-loudness-r16/mixed_tech/v14 --out /tmp/dcx-loudness-r16/mixed_tech",
    "test:voice:slow-leveling": "scripts/voice/.venv/bin/python scripts/voice/test_slow_leveling.py",
    "test:voice:gate:all": "scripts/voice/.venv/bin/python scripts/voice/longtext_probe.py --from-config --check",
    "test:voice:ab:r17": "scripts/voice/.venv/bin/python scripts/voice/loudness_drift_probe.py --live --from-config --case mixed_tech --voice serena --skip-raw --with-v16 --with-v17 --with-v17-strong --out /tmp/dcx-r17-ab/mixed_tech && scripts/voice/.venv/bin/python scripts/voice/loudness_drift_probe.py --compare /tmp/dcx-r17-ab/mixed_tech/v16 /tmp/dcx-r17-ab/mixed_tech/v17 /tmp/dcx-r17-ab/mixed_tech/v17-k10 --out /tmp/dcx-r17-ab/mixed_tech",
    "test:voice:matrix": "python3 scripts/voice/mixed_matrix_probe.py --check",
    "test:voice:matrix:unit": "python3 scripts/voice/test_mixed_matrix.py",
    "test:voice:tns": "python3 scripts/voice/tns_probe.py --check",
    "test:voice:tns:unit": "python3 scripts/voice/test_text_normalize.py",
    "test:voice:atomic": "python3 scripts/voice/test_atomic_chunks.py",
    "test:voice:atomic:ab": "python3 scripts/voice/chunking_ab_probe.py --offline --cells code:xl,plain:xl",
    "test:voice:longtext:atomic": "python3 scripts/voice/longtext_probe.py --atomic --check",
    "test:voice:matrix:atomic": "python3 scripts/voice/mixed_matrix_probe.py --atomic --check",
    "test:voice:shortgap": "python3 scripts/voice/test_short_gap.py",
    "test:voice:shortgap:ab": "python3 scripts/voice/chunking_ab_probe.py --offline --cells num:xs,code:m --modes baseline,atomic,shortgap,atomic_shortgap",
    "test:voice:longtext:shortgap": "python3 scripts/voice/longtext_probe.py --short-gap --check",
    "test:voice:matrix:shortgap": "python3 scripts/voice/mixed_matrix_probe.py --short-gap --check",
    "test:voice:matrix:both": "python3 scripts/voice/mixed_matrix_probe.py --atomic --short-gap --check",
    "release:version": "node scripts/version.js",
    "prepare:package": "node scripts/prepare-package.js",
    "prepare:vscode": "node scripts/prepare-vscode.js",
    "prepare": "husky && npm run build && npm run bundle",
    "rebuild:sqlite": "bash scripts/install-better-sqlite3.sh",
    "install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "rebuild:sqlite:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1 -SqliteOnly",
    "test:e2e:super:team": "tsx tests/scripts/super-agent-team-e2e.ts",
    "start:web": "node scripts/start.js web",
    "voice:start": "bash scripts/voice/start.sh"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
