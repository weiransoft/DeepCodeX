# =============================================================================
# bio-vlab 应用服务器 compose env 模板（10.101.66.29 直装版）
#
# 用法：
#   cd /opt/bio-vlab && cp .env.app.example .env && vi .env
#   docker compose -f docker-compose.app.yml --env-file .env up -d
#
# 密钥安全：本模板所有密钥字段一律留空，由部署平台 secret 机制或运维手工
# 填入本地 .env（.env 已在 .gitignore 中，绝不入库）。
# =============================================================================

# ---- 必填密钥（留空会导致容器启动即失败，属预期保护） ----
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---- 数据库 / 对象存储基本参数 ----
MYSQL_DATABASE=bio_ai
MYSQL_USER=bio_app
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=bio-ai

# ---- 对外访问 ----
# [CORS 修复 2026-10-11] GPU 机前端跑在 3100（20.20/20.30），66.29 前端在 3000；
# 走 frontend 同源 rewrites 不受 CORS 限制，此处仅覆盖浏览器直连 8080 API 的场景
CORS_ORIGINS=["http://10.101.20.20:3100","http://10.101.20.30:3100","http://10.101.66.29:3000"]

# ---- GPU 机（10.101.20.30）上的模型服务 ----
BOLTZ_HOST=10.101.20.30
BOLTZ_PORT=8000
PROTEINMPNN_API_URL=http://10.101.20.30:8085
RFDIFFUSION_API_URL=http://10.101.20.30:8083

# ---- OpenDDE 契约适配网关（T-004 / D3 修复新增，必须固化） ----
# 网关部署在 GPU 机（docker/opendde-gateway 构建，容器端口 8090）。
# 不固化时 backend 回落 config.py 默认 127.0.0.1:8090 → 容器内不可达，
# 且运行时 PUT /settings/runtime 的 override 只作用于执行层，展示层
# （运行时配置页 / 组件健康探测）会恒显 down。
OPENDDE_HOST=10.101.20.30
OPENDDE_PORT=8090
OPENDDE_REQUEST_TIMEOUT=1800

# ---- AF3（T-028 修复 2026-10-19：CUDA 服务固化 8092，Mac MLX 遗留 8642 退役） ----
# bio-alphafold3 容器以运行时 env AF3_PORT=8092 覆盖镜像内置 8642，服务监听 8092
# （cuda-jax 后端）。同机部署按容器名 alphafold3 直连（attach-models.sh 接入 bio-net）；
# 拆机部署改 AF3_HOST 为 GPU 机 IP。
AF3_HOST=alphafold3
AF3_PORT=8092

# ---- LLM ----
LLM_API_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=Qwen3.6-35B-A3B-FP8

# ---- 数据库结构（DDL）管理（T-004 / D4 修复新增） ----
# backend 服务：启动前执行 alembic upgrade head（内部对 alembic_version 加
# MySQL GET_LOCK 串行化，多副本也安全）
MIGRATIONS_ENABLED=true
# backend 服务：False = 不再无条件裸 Base.metadata.create_all（消除启动期
# CREATE TABLE already exists / pymysql 1050 告警栈）；缺表时以
# create_all(checkfirst=True) 幂等兜底补齐
AUTO_CREATE_ALL=false
# celery-worker 多副本：一律关闭 DDL，避免并发建表竞态
WORKER_MIGRATIONS_ENABLED=false
WORKER_AUTO_CREATE_ALL=false
